  <node id="5220080011" version="8" timestamp="2025-04-08T21:51:42Z" uid="270456" user="pyrog" changeset="164698932" lat="48.8599793" lon="2.3893355">
    <tag k="board_type" v="history"/>
    <tag k="information" v="board"/>
    <tag k="inscription" v="Créé pour remplacer les cimetières paroissiaux insalubres, ce parc funéraire paysager, a été dessiné par Alexandre Théodore Brongniart. Planté de 4134 arbres de 76 essences différentes, ses 43,2 hectares font de lui le plus vaste espace verts dans Paris."/>
    <tag k="inscription:2" v="Précurseur de l&apos;évolution des pratiques funéraires, il est le premier cimetière de France à se doter d&apos;une crématorium (1890), d&apos;un columbarium (1893-1912) et d&apos;un jardin cinéraire (1985). Le cimetière compte 69000 sépultures."/>
    <tag k="inscription:3" v="Ce haut lieu de mémoire abrite le mur des Fédérés, les monuments des Déportés et des Combattants étrangers, et les sépultures de nombreux défunts célèbres."/>
    <tag k="name" v="Cimetière du Père-Lachaise"/>
    <tag k="operator" v="Mairie de Paris"/>
    <tag k="panoramax" v="4642f23b-c76a-4dc6-b39a-992ef484bdd9;509ea9e8-7a74-4014-8d20-911710e430e2"/>
    <tag k="subject:wikidata" v="Q311"/>
    <tag k="tourism" v="information"/>
  </node>
